# Copy to backend/.env and fill in what you need. Everything is optional for local development.
ENVIRONMENT=development            # set to "production" when deploying
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_EMAILS=you@example.com       # comma-separated emails that get admin rights

# Real Google sign-in (OAuth client ID from Google Cloud console). Empty = hidden.
GOOGLE_CLIENT_ID=

# AI (optional). Without keys GapX uses its built-in offline engines.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_FALLBACK_MODELS=gemini-2.5-flash-preview-tts,gemini-3.8-flash-tts,gemini-2.5-pro-preview-tts
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Code execution. Use Judge0 in production; local execution is for development only.
JUDGE0_API_KEY=
ALLOW_LOCAL_CODE_EXECUTION=true

# Email verification codes at sign-up (Gmail: create an App Password under Google Account > Security > 2-Step Verification > App passwords)
EMAIL_VERIFICATION_REQUIRED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# "Continue with Google": OAuth Client ID (Web application) from console.cloud.google.com, with http://localhost:3000 as an authorised JavaScript origin
GOOGLE_CLIENT_ID=

# Separate admin panel login (http://localhost:3000/admin)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-to-a-strong-password
